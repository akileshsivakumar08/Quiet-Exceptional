<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.AppCompat.Light"
    android:background="#FFFBF2">



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="495dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#808080" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3B3B3B"
                android:padding="8dp"
                android:text="@string/Settings"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="This app has been in development for a couple of years and it would have not at all been possible without the love and support of my Wife. .\nIn November 2023, as Quiet Exceptional was still being developed, Google made it mandatory that every new app that was being released should now be tested by 20 Testers in the closed testing stage. Big thanks to everyone who decided to support Quiet exceptional in one way or another. "
                android:textColor="#808080"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#808080" />
            <TextView
                android:id="@+id/configuretext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Configure Missed Call Text"
                android:textColor="#525252"
                android:textSize="14sp" />



        </LinearLayout>


    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>