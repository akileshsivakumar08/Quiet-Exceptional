    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/TapToEnable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/FeatTitle"
        android:text="@string/Allfeat_Tap2Enable"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/FeatTitle" />

    <TextView
        android:id="@+id/FeatTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/ARC_Title"
        android:textAlignment="center"
        android:textColor="#FFD369"
        android:textSize="75sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.301" />

    <SeekBar
        android:id="@+id/seekBar_ARC"
        android:layout_width="285dp"
        android:layout_height="24dp"
        android:layout_below="@+id/TapToEnable"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TapToEnable" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/ARC_Volume"
        android:textColor="#DDE1ED"
        app:layout_constraintEnd_toEndOf="@+id/seekBar_ARC"
        app:layout_constraintStart_toStartOf="@+id/seekBar_ARC"
        app:layout_constraintTop_toBottomOf="@+id/seekBar_ARC" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100%"
        android:textColor="#DDE1ED"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintEnd_toEndOf="@+id/seekBar_ARC"
        app:layout_constraintStart_toStartOf="@+id/seekBar_ARC"
        app:layout_constraintTop_toBottomOf="@+id/seekBar_ARC" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="#DDE1ED"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/seekBar_ARC"
        app:layout_constraintTop_toBottomOf="@+id/seekBar_ARC" />

    <TextView
        android:id="@+id/taptotestvolume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/TapVolumeTest"
        android:textColor="#DDE1ED"
        app:layout_constraintEnd_toEndOf="@+id/textView8"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintStart_toStartOf="@+id/textView8"
        app:layout_constraintTop_toBottomOf="@+id/seekBar_ARC" />


</androidx.constraintlayout.widget.ConstraintLayout>